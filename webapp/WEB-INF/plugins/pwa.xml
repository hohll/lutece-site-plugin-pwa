<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<plug-in>
    <name>pwa</name>
    <class>fr.paris.lutece.portal.service.plugin.PluginDefaultImplementation</class>
    <version>2.0.0-SNAPSHOT</version>
    <documentation></documentation>
    <installation></installation>
    <changes></changes>
    <user-guide></user-guide>
    <description>pwa.plugin.description</description>
    <provider>pwa.plugin.provider</provider>
    <provider-url>http://dev.lutece.paris.fr</provider-url>
    <icon-url>themes/admin/shared/plugins/pwa/images/pwa.svg</icon-url>
    <copyright>Copyright (c) 2018 Mairie de Paris</copyright>
    <db-pool-required>0</db-pool-required>
    
    <core-version-dependency>
        <min-core-version>8.0.0</min-core-version>
        <max-core-version/>	
    </core-version-dependency>

    <admin-features>
        <admin-feature>
            <feature-id>PWA_MANAGEMENT</feature-id>
            <feature-title>pwa.adminFeature.managePwa.name</feature-title>
            <feature-description>pwa.adminFeature.managePwa.description</feature-description>
            <feature-level>2</feature-level>
            <feature-url>jsp/admin/plugins/pwa/ManagePwa.jsp</feature-url>
            <icon-url>ti ti-device-mobile-cog</icon-url>
            <feature-group>SITE</feature-group>
        </admin-feature>
    </admin-features>

	<page-include-services>
		<page-include-service>
			<page-include-service-id>Include Service for the head of the progressive web app</page-include-service-id>
			<page-include-service-class>fr.paris.lutece.plugins.pwa.web.PwaHeadInclude</page-include-service-class>
		</page-include-service>
		<page-include-service>
			<page-include-service-id>Include Service for the install button of the progressive web app</page-include-service-id>
			<page-include-service-class>fr.paris.lutece.plugins.pwa.web.InstallButtonInclude</page-include-service-class>
		</page-include-service>
		<page-include-service> 
			<page-include-service-id>Include Service for the Web Manifest file</page-include-service-id> 
			<page-include-service-class>fr.paris.lutece.plugins.pwa.web.ManifestInclude</page-include-service-class> 
		</page-include-service>
		<page-include-service> 
			<page-include-service-id>Include Service for Service Worker</page-include-service-id> 
			<page-include-service-class>fr.paris.lutece.plugins.pwa.web.ServiceWorkerInclude</page-include-service-class> 
		</page-include-service>
	</page-include-services>
	
	<!-- servlets -->
     <servlets>
          <servlet>
               <servlet-name>PwaServlet</servlet-name>
               <url-pattern>/servlet/plugins/pwa/ManifestServlet</url-pattern>
               <servlet-class>fr.paris.lutece.plugins.pwa.web.ManifestServlet</servlet-class>
          </servlet>
          <servlet>
               <servlet-name>PwaOfflineServlet</servlet-name>
               <url-pattern>/servlet/plugins/pwa/offline</url-pattern>
               <servlet-class>fr.paris.lutece.plugins.pwa.web.OfflineServlet</servlet-class>
          </servlet>
          <servlet>
               <servlet-name>PwaImageServlet</servlet-name>
               <url-pattern>/servlet/plugins/pwa/image</url-pattern>
               <servlet-class>fr.paris.lutece.plugins.pwa.web.ImageServlet</servlet-class>
          </servlet>
     </servlets>

<!-- XPages parameters -->
    <applications>
        <application>
            <application-id>offline</application-id>
        </application>
    </applications>     
    
</plug-in>